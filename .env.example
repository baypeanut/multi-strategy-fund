# Copy to .env and fill in. .env is gitignored and must stay that way.
# Services also accept environment variables and Kubernetes Secrets. Keep
# credentials out of logs, state, reports, command arguments and build contexts.

# Anthropic. Used by the S3 portfolio manager, the research director and the
# security audit agent. Without it the fund still runs: S3 falls back to a
# deterministic heuristic and the audit runs its rule layer only.
ANTHROPIC_API_KEY=

# Telegram alerts. Optional. Empty values disable alerting, they do not error.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional paid data. The fund is designed to run on free sources
# (yfinance, ccxt public, SEC EDGAR, FRED) and works with both of these blank.
# Polygon supplies intraday equity bars, Nasdaq Data Link supplies Sharadar
# point-in-time fundamentals.
POLYGON_API_KEY=
NASDAQ_DATA_LINK_API_KEY=

# Optional validated vLLM gateway. This does not enable the provider; selecting
# llm.provider: vllm is a separate, deliberate experiment/configuration change.
FUND_VLLM_API_KEY=
FUND_VLLM_BASE_URL=http://127.0.0.1:8081/v1
FUND_VLLM_MODEL=fund-llm

# Dashboard binds localhost by default. Remote binding requires a password of
# at least 16 characters; the username defaults to fund. Use TLS at a trusted
# reverse proxy or keep access inside an SSH tunnel.
FUND_DASHBOARD_USER=fund
FUND_DASHBOARD_PASSWORD=

# Broker credentials are deliberately NOT here. The IB Gateway reads them from
# its own root-owned 0600 config outside the repo, so the trading process never
# holds them and they cannot reach a diff.
